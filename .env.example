# Blog image adapter mode.
# Use "local" to keep the open-source build working without Cloudflare.
# Switch to "cloudflare" only when you want the build step to upload blog images to Cloudflare Images.
BLOG_IMAGE_ADAPTER=local

# Cloudflare account ID used by the Hosted Images API.
# Required only when BLOG_IMAGE_ADAPTER=cloudflare.
CLOUDFLARE_IMAGES_ACCOUNT_ID=

# Cloudflare API token with Images Write permission.
# Keep the real value private and store it only in your local .env file.
# Required only when BLOG_IMAGE_ADAPTER=cloudflare.
CLOUDFLARE_IMAGES_API_TOKEN=

# Delivery variant returned by the adapter after upload.
# The default "public" variant works for the common Hosted Images setup.
CLOUDFLARE_IMAGES_VARIANT=public